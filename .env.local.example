# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.local.example .env.local
# 값 확인 위치: Supabase 대시보드 → Project Settings → API
# ─────────────────────────────────────────────────────────────

# 클라이언트(브라우저)에 노출되는 값. anon key는 RLS 정책으로 보호됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 서버 전용 키 — RLS를 우회합니다.
#    절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. 클라이언트 코드에서 import 금지.
#    용도: 학생 계정 일괄 생성 등 관리자 작업(API Route에서만 사용).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ⚠️ 서버 전용 — AI 기능.
# 키는 여기(환경변수) 또는 관리자 화면(설정 > AI 키·모델)에서 등록할 수 있다.
# 관리자 화면에 등록한 키가 우선하며, 없으면 아래 환경변수를 폴백으로 쓴다.
# 셋 중 최소 하나는 있어야 하고, 관리자가 그 제공자의 모델을 추가하면 학생이 선택 가능.
OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
