# ─────────────────────────────────────────────────────────────
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.local.example .env.local
# 값 확인 위치: Supabase 대시보드 → Project Settings → API
# ─────────────────────────────────────────────────────────────

# 클라이언트(브라우저)에 노출되는 값. anon key는 RLS 정책으로 보호됩니다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 서버 전용 키 — RLS를 우회합니다.
#    절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. 클라이언트 코드에서 import 금지.
#    용도: 학생 계정 일괄 생성 등 관리자 작업(API Route에서만 사용).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ⚠️ 서버 전용 — AI 기능(2단계).
# AI_PROVIDER: 'gpt'(기본) | 'claude'. 해당 provider의 키만 있으면 된다.
# 모델 변경은 lib/ai/provider.ts 의 GPT_MODELS / CLAUDE_MODELS 수정.
AI_PROVIDER=gpt
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
